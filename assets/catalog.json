  "steps": [
    { "id": "download", "name": "取音频", "fixed": true },
    { "id": "separate", "name": "分离人声", "required": true },
    { "id": "karaoke", "name": "拆主唱", "optional": true, "why": "歌里有和声时，只留主唱，她才不会被和声带跑调。" },
    { "id": "dereverb", "name": "去混响", "optional": true, "why": "擦掉原唱的混响，她的声音更干净。" },
    { "id": "lyrics", "name": "对歌词", "optional": true, "why": "找到对的歌词并对上时间，播放时逐字亮。" },
    { "id": "pitch", "name": "修音高", "optional": true, "patch": true, "why": "分离不干净时，把唱错八度的地方拉回来。原唱本来就忽高忽低的歌可以关掉。" },
    { "id": "key", "name": "定调", "patch": true, "modes": ["auto", "none", "fixed"], "why": "自动挑她唱着最舒服的调；也可以不移调，或者自己定升降几个半音。" },
    { "id": "convert", "name": "换成她的声音", "required": true },
    { "id": "mix", "name": "混音", "fixed": true }
  ],
  "recipes": [
    { "id": "recommended", "name": "推荐", "note": "现在直播里学歌用的这一套，质量最好。",
      "use": { "separate": "sep-polarformer", "karaoke": "kara-becruily", "dereverb": "derev-anvuew", "lyrics": "whisper-large-v3", "pitch": true, "key": "auto" } },
    { "id": "fast", "name": "快速", "note": "只分离人声再换声音，下载最少（不到 1 GB）、学得最快，有和声的歌容易跑调。",
      "use": { "separate": "sep-polarformer", "karaoke": null, "dereverb": null, "lyrics": null, "pitch": false, "key": "auto" } }
  ]
}
